# ── Form defaults ──────────────────────────────────────────────────────
# Optional. Anything set here is prefilled into the form on page load, served by
# GET /api/defaults. The password does reach the browser, which is fine only
# because this app is local-only by design -- do not deploy it.
MENTARI_USERNAME=
MENTARI_PASSWORD=
# MENTARI_CAPTCHA=test
# MENTARI_QUIZ_ID=
# MENTARI_KODE_COURSE=
# MENTARI_KODE_SECTION=
# Preselected provider: gemini | ollama-cloud | ollama | anthropic
# MENTARI_AI_PROVIDER=ollama-cloud

# ── AI providers ───────────────────────────────────────────────────────
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama, local. The code appends /v1 itself, so no path here.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# Ollama Cloud (provider "ollama-cloud"). Key: https://ollama.com/settings/keys
OLLAMA_API_KEY=
# Model list: https://ollama.com/search?c=cloud -- use the name WITHOUT the
# "-cloud" suffix (gpt-oss:120b, deepseek-v3.1:671b, qwen3-coder:480b, ...).
# OLLAMA_CLOUD_MODEL=gpt-oss:120b
# OLLAMA_CLOUD_BASE_URL=https://ollama.com

# ── Browser transport ──────────────────────────────────────────────────
# mentari.unpam.ac.id is behind a Cloudflare Managed Challenge, so every request
# is issued from inside a real Chrome window driven by patchright.
# All of these are optional; the defaults are what has been verified to work.

# Headless does NOT clear the interactive Turnstile checkbox. Leave this unset.
# MENTARI_BROWSER_HEADLESS=true

# Browser channel. Empty string uses patchright's bundled Chromium (untested here).
# MENTARI_BROWSER_CHANNEL=chrome

# Persistent Chrome profile holding the cf_clearance cookie.
# Default: %LOCALAPPDATA%\mentari-assistants\chrome-profile
# Keep it OUTSIDE the repo -- a Chrome profile churns files and would thrash the
# Next dev watcher.
# MENTARI_BROWSER_PROFILE_DIR=

# MENTARI_BROWSER_ORIGIN=https://mentari.unpam.ac.id

# Close the browser after this many ms idle. 0 disables. Never fires mid-run.
# MENTARI_BROWSER_IDLE_MS=600000

# MENTARI_REQUEST_TIMEOUT_MS=30000
# MENTARI_CHALLENGE_TIMEOUT_MS=60000
# MENTARI_BROWSER_NAV_TIMEOUT_MS=45000

# Attach to a Chrome you started yourself instead of launching one:
#   chrome.exe --remote-debugging-port=9222 --user-data-dir=C:\some\dir
# Useful if Next dev spawns multiple workers and they fight over the profile lock.
# MENTARI_BROWSER_CDP_URL=http://localhost:9222

# Log every request: method, path, status, duration, challenge retries.
# MENTARI_BROWSER_DEBUG=1

# One-flag rollback to plain Node fetch (which currently gets a 403 interstitial).
# MENTARI_BROWSER_DISABLED=1
